{
  "name": "lord-of-the-subs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "sync": "node sync/index.mjs",
    "sync:once": "node sync/index.mjs --once",
    "install:cursor-hook": "node sync/install-cursor-hook.mjs",
    "test": "node --test sync/*.test.mjs shared/*.test.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/charts": "^1.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
